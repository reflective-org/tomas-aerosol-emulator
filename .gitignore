# Data and run outputs (large; not checked in)
data/
runs/
*.npz
!checkpoints/*.npz

# Keep the shipped checkpoints, ignore everything else heavy.
# checkpoints/{axial_aug5,axial_cons2}/best_model.pt are deliberately NOT
# tracked: each is ~113 MB (over GitHub's 100 MB limit) and ships as a release
# asset instead (scripts/download_axial_checkpoint.sh).
*.pt
!checkpoints/*.pt
!checkpoints/axial_aug5/norm_stats.pt
!checkpoints/axial_cons2/norm_stats.pt

